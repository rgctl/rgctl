{
  "grammar": "tree-sitter-bash@0.25.1",
  "handlers": {
    "ansi_c_string": "Literal",
    "arithmetic_expansion": "AstSkeleton",
    "array": "Literal",
    "binary_expression": "CfgStatement",
    "brace_expression": "AstSkeleton",
    "c_style_for_statement": "CfgStatement",
    "case_item": "CfgStatement",
    "case_statement": "CfgStatement",
    "command": "Relation",
    "command_name": "SkipWrapper",
    "command_substitution": "Relation",
    "comment": "Literal",
    "compound_statement": "CfgStatement",
    "concatenation": "SkipWrapper",
    "declaration_command": "Symbol",
    "do_group": "SkipWrapper",
    "elif_clause": "CfgStatement",
    "else_clause": "CfgStatement",
    "expansion": "AstSkeleton",
    "extglob_pattern": "Literal",
    "file_descriptor": "SkipTypeToken",
    "file_redirect": "SkipWrapper",
    "for_statement": "CfgStatement",
    "function_definition": "Symbol",
    "heredoc_body": "Literal",
    "heredoc_content": "Literal",
    "heredoc_end": "Literal",
    "heredoc_redirect": "SkipWrapper",
    "heredoc_start": "Literal",
    "herestring_redirect": "SkipWrapper",
    "if_statement": "CfgStatement",
    "list": "CfgStatement",
    "negated_command": "CfgStatement",
    "number": "Literal",
    "parenthesized_expression": "SkipWrapper",
    "pipeline": "CfgStatement",
    "postfix_expression": "AstSkeleton",
    "process_substitution": "SkipWrapper",
    "program": "SkipWrapper",
    "raw_string": "Literal",
    "redirected_statement": "CfgStatement",
    "regex": "Literal",
    "simple_expansion": "AstSkeleton",
    "special_variable_name": "Literal",
    "string": "Literal",
    "string_content": "Literal",
    "subscript": "SkipWrapper",
    "subshell": "CfgStatement",
    "ternary_expression": "CfgStatement",
    "test_command": "CfgStatement",
    "test_operator": "SkipTypeToken",
    "translated_string": "Literal",
    "unary_expression": "CfgStatement",
    "unset_command": "AstSkeleton",
    "variable_assignment": "AstSkeleton",
    "variable_assignments": "SkipWrapper",
    "variable_name": "Literal",
    "while_statement": "CfgStatement",
    "word": "Literal"
  },
  "skip_justifications": {
    "parenthesized_expression": "Pure grouping wrapper `(expr)` around an inner expression node; child expression is visited directly."
  }
}
