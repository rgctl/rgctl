{
  "grammar": "tree-sitter-elixir@0.3.5",
  "handlers": {
    "access_call": "Relation",
    "after_block": "CfgStatement",
    "alias": "Relation",
    "anonymous_function": "Symbol",
    "arguments": "SkipWrapper",
    "atom": "Literal",
    "binary_operator": "CfgStatement",
    "bitstring": "SkipWrapper",
    "block": "SkipWrapper",
    "body": "SkipWrapper",
    "boolean": "Literal",
    "call": "Symbol",
    "catch_block": "CfgStatement",
    "char": "Literal",
    "charlist": "Literal",
    "comment": "Literal",
    "do_block": "SkipWrapper",
    "dot": "SkipWrapper",
    "else_block": "CfgStatement",
    "escape_sequence": "Literal",
    "float": "Literal",
    "identifier": "SkipTypeToken",
    "integer": "Literal",
    "interpolation": "SkipWrapper",
    "keyword": "SkipTypeToken",
    "keywords": "SkipWrapper",
    "list": "SkipWrapper",
    "map": "SkipWrapper",
    "map_content": "SkipWrapper",
    "nil": "Literal",
    "operator_identifier": "SkipTypeToken",
    "pair": "SkipWrapper",
    "quoted_atom": "Literal",
    "quoted_content": "SkipWrapper",
    "quoted_keyword": "SkipTypeToken",
    "rescue_block": "CfgStatement",
    "sigil": "Literal",
    "sigil_modifiers": "SkipTypeToken",
    "sigil_name": "SkipTypeToken",
    "source": "SkipWrapper",
    "stab_clause": "CfgStatement",
    "string": "Literal",
    "struct": "SkipWrapper",
    "tuple": "SkipWrapper",
    "unary_operator": "SkipWrapper"
  },
  "language": "elixir"
}
