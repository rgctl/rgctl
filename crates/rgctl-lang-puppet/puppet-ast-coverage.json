{
  "grammar": "tree-sitter-puppet@1.3.0",
  "handlers": {
    "array": "Literal",
    "array_type": "SkipTypeToken",
    "assignment": "AstSkeleton",
    "attribute": "SkipWrapper",
    "attribute_type": "SkipTypeToken",
    "attribute_type_entry": "SkipWrapper",
    "binary_expression": "CfgStatement",
    "block": "CfgStatement",
    "boolean": "Literal",
    "builtin_type": "Literal",
    "case_item": "CfgStatement",
    "case_statement": "CfgStatement",
    "class_definition": "Symbol",
    "class_identifier": "Literal",
    "class_inherits": "Relation",
    "comment": "Literal",
    "composite_type": "SkipTypeToken",
    "default": "Literal",
    "default_case": "CfgStatement",
    "defined_resource_type": "Symbol",
    "else_statement": "CfgStatement",
    "elsif_statement": "CfgStatement",
    "escape_sequence": "Literal",
    "field_expression": "AstSkeleton",
    "float": "Literal",
    "function_call": "Relation",
    "function_declaration": "Symbol",
    "hash": "Literal",
    "identifier": "Literal",
    "if_statement": "CfgStatement",
    "include_statement": "Relation",
    "interpolation": "SkipWrapper",
    "iterator_statement": "CfgStatement",
    "lambda": "Symbol",
    "node_definition": "Symbol",
    "node_name": "Literal",
    "number": "Literal",
    "parameter": "SkipWrapper",
    "parameter_list": "SkipWrapper",
    "parenthesized_expression": "SkipWrapper",
    "regex": "Literal",
    "relation": "Relation",
    "require_statement": "Relation",
    "resource_collector": "Relation",
    "resource_declaration": "Symbol",
    "resource_default": "Relation",
    "resource_reference": "Relation",
    "search_expression": "Relation",
    "selector": "CfgStatement",
    "source_file": "SkipWrapper",
    "string": "Literal",
    "string_content": "Literal",
    "tag_statement": "Relation",
    "type_declaration": "Symbol",
    "unary_expression": "AstSkeleton",
    "undef": "Literal",
    "unless_statement": "CfgStatement",
    "variable": "Symbol"
  },
  "skip_justifications": {
    "parenthesized_expression": "Pure grouping wrapper `(expr)` around an inner expression node; child expression is visited directly."
  }
}
