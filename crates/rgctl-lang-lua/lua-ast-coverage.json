{
  "grammar": "tree-sitter-lua@0.5.0",
  "handlers": {
    "arguments": "SkipWrapper",
    "assignment_statement": "Symbol",
    "attribute": "SkipWrapper",
    "binary_expression": "CfgStatement",
    "block": "CfgStatement",
    "bracket_index_expression": "AstSkeleton",
    "break_statement": "CfgStatement",
    "chunk": "SkipWrapper",
    "comment": "Literal",
    "comment_content": "Literal",
    "do_statement": "CfgStatement",
    "dot_index_expression": "AstSkeleton",
    "else_statement": "CfgStatement",
    "elseif_statement": "CfgStatement",
    "empty_statement": "CfgStatement",
    "escape_sequence": "Literal",
    "expression_list": "SkipWrapper",
    "false": "Literal",
    "field": "SkipWrapper",
    "for_generic_clause": "CfgStatement",
    "for_numeric_clause": "CfgStatement",
    "for_statement": "CfgStatement",
    "function_call": "Relation",
    "function_declaration": "Symbol",
    "function_definition": "Symbol",
    "goto_statement": "CfgStatement",
    "hash_bang_line": "SkipWrapper",
    "identifier": "SkipWrapper",
    "if_statement": "CfgStatement",
    "implicit_variable_declaration": "AstSkeleton",
    "label_statement": "CfgStatement",
    "method_index_expression": "AstSkeleton",
    "nil": "Literal",
    "number": "Literal",
    "parameters": "AstSkeleton",
    "parenthesized_expression": "SkipWrapper",
    "repeat_statement": "CfgStatement",
    "return_statement": "CfgStatement",
    "string": "Literal",
    "string_content": "Literal",
    "table_constructor": "Symbol",
    "true": "Literal",
    "unary_expression": "CfgStatement",
    "vararg_expression": "Literal",
    "variable_declaration": "AstSkeleton",
    "variable_list": "SkipWrapper",
    "while_statement": "CfgStatement"
  },
  "language": "lua",
  "skip_justifications": {
    "parenthesized_expression": "Pure grouping wrapper `(expr)` around an inner expression node; child expression is visited directly."
  }
}
