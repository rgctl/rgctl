{
  "schema_version": 2,
  "language": "elixir",
  "project": "correctness-elixir",
  "graph": {
    "severity": "required",
    "min_functions": 16,
    "min_calls_edges": 10,
    "forbidden_edges": [
      {
        "from": "correctness_leaf",
        "to": "correctness_root"
      }
    ]
  },
  "symbols": {
    "correctnessLeaf": {
      "match": {
        "name": "correctness_leaf",
        "class": "CorrectnessHarness"
      },
      "severity": "required",
      "unique": true,
      "exact_callees": [],
      "exact_callers": ["correctness_mid"],
      "blast": {
        "exact_direct_callers": ["correctness_mid"]
      },
      "cfg": {
        "min_blocks": 1
      }
    },
    "correctnessMid": {
      "match": {
        "name": "correctness_mid",
        "class": "CorrectnessHarness"
      },
      "severity": "required",
      "unique": true,
      "exact_callees": ["correctness_leaf"],
      "exact_callers": ["correctness_root"],
      "blast": {
        "exact_direct_callers": ["correctness_root"]
      },
      "cfg": {
        "min_blocks": 3,
        "statements_contain": ["correctness_leaf"]
      }
    },
    "correctnessRoot": {
      "match": {
        "name": "correctness_root",
        "class": "CorrectnessHarness"
      },
      "severity": "required",
      "unique": true,
      "exact_callees": ["correctness_mid"],
      "exact_callers": [],
      "cfg": {
        "min_blocks": 3,
        "statements_contain": ["correctness_mid"]
      }
    },
    "correctnessShared": {
      "match": {
        "name": "correctness_shared",
        "class": "CorrectnessHarness"
      },
      "severity": "required",
      "unique": true,
      "exact_callers": ["correctness_left", "correctness_right"],
      "blast": {
        "exact_direct_callers": ["correctness_left", "correctness_right"]
      }
    },
    "cfgIfBranch": {
      "match": {
        "name": "cfg_if_branch",
        "class": "CfgFeatures"
      },
      "severity": "required",
      "unique": true,
      "cfg": {
        "min_blocks": 3
      }
    },
    "v2AuditWeightImpl": {
      "match": {
        "name": "audit_weight",
        "class": "V2OrderLedger",
        "discriminator": "V2OrderLedger"
      },
      "severity": "required",
      "unique": true,
      "exact_callees": ["read_balance"],
      "mro": {
        "extends": ["V2BaseLedger"],
        "implements": ["V2AuditPolicy"],
        "overrides": ["audit_weight"]
      }
    },
    "v2SliceFlowProbe": {
      "match": {
        "name": "v2_slice_flow_probe",
        "class": "CorrectnessHarness"
      },
      "severity": "required",
      "unique": true,
      "slice": {
        "file": "lib/correctness_harness.ex",
        "line": 42,
        "variable": "final_out",
        "must_contain": ["seed_input", "step_val"],
        "must_exclude": ["999"]
      },
      "flows": {
        "file": "lib/correctness_harness.ex",
        "line": 40,
        "variable": "step_val",
        "must_contain": ["alias_val", "final_out"]
      }
    },
    "v2TaintExec": {
      "match": {
        "name": "taint_unsafe_exec",
        "class": "CorrectnessHarness"
      },
      "severity": "required",
      "unique": true,
      "taint": {
        "sink": "Ecto.Adapters.SQL.query",
        "source": "external",
        "min_flows": 1,
        "must_contain": ["taint_unsafe_exec"]
      }
    },
    "v2CloneExactA": {
      "match": {
        "name": "v2_clone_exact",
        "class": "V2CloneCarrierA"
      },
      "severity": "required",
      "unique": true,
      "clones": {
        "mode": "exact",
        "group_with": ["v2_clone_exact"],
        "not_grouped_with": ["correctness_leaf"]
      }
    },
    "v2SemanticLedger": {
      "match": {
        "name": "reconcile_chargeback_ledger",
        "class": "CorrectnessHarness"
      },
      "severity": "required",
      "unique": true,
      "exact_callees": ["archive_chargeback_audit"],
      "semantic": {
        "query": "reconcile chargeback ledger",
        "top3_contains": "reconcile_chargeback_ledger",
        "neighbor_names": ["archive_chargeback_audit"]
      },
      "review": {
        "file": "lib/correctness_harness.ex",
        "find": "42",
        "replace": "43",
        "must_contain": ["correctness_mid"]
      }
    }
  },
  "invariants": {
    "B1_blast_vs_calls": {
      "enabled": true,
      "severity": "required",
      "symbols": ["correctnessLeaf", "correctnessMid", "correctnessShared"]
    },
    "B2_gql_calls_nonzero": {
      "enabled": true,
      "severity": "required"
    },
    "B5_inspect_cfg_present": {
      "enabled": true,
      "severity": "required",
      "symbols": ["correctnessRoot", "correctnessMid", "correctnessLeaf"]
    },
    "B6_cfg_calls_subset_of_calls_edges": {
      "enabled": true,
      "severity": "required",
      "symbols": ["correctnessRoot", "correctnessMid"]
    },
    "B7_pdg_lines_subset_cfg": {
      "enabled": true,
      "severity": "required",
      "symbols": ["correctnessRoot", "correctnessMid", "correctnessLeaf"]
    },
    "B8_dom_blocks_match_cfg": {
      "enabled": true,
      "severity": "required",
      "symbols": ["correctnessRoot", "correctnessMid", "correctnessLeaf"]
    },
    "B9_blast_target_name": {
      "enabled": true,
      "severity": "required",
      "symbols": ["correctnessRoot", "correctnessMid", "correctnessLeaf"]
    }
  },
  "analytics": {
    "severity": "required",
    "root": "correctness_root",
    "mid": "correctness_mid",
    "leaf": "correctness_leaf",
    "separate": ["clique_alpha_a", "clique_beta_a"]
  }
}
