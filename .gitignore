# AI local state
.cursor/
.claude/
.opencode/
.agent
.antigravity/
.reports
# OpenSpec change proposals (local only — do not commit)
openspec/
.scratch/
.playwright-mcp/

# Rust
/target
# Cargo.lock is tracked: this is a binary workspace (`publish = false`); without a
# committed lock, fresh clones can resolve pre-release deps (e.g. ort) to breaking APIs (#123).
**/*.rs.bk
*.pdb

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# scripts
.scripts

# Agent pack codegen output (embed uses OUT_DIR only)
agent-pack/out/

#misc
skills-lock.json
/dist

# Generated graph data (any depth — never commit local indexes)
**/.rgbuilder/
**/.rgctl/
**/.rgctl-diff/
/coverage
*.profraw
*.profdata

# Benchmarks
/target/criterion

# Build artifacts
*.so
*.dylib
*.dll

# Graph data (don't commit large graphs)
graph.db
graph.json
graphify-out/

# MCP (local MCP state — skill entrypoints allowed above via !.claude/skills/)

# Logs
*.log

# Temporary files
*.tmp
.cache/

# Local large fixtures (clone separately; not part of the repo)
/example/*
!/example/README.md

# VHS / Playwright intermediate recordings
docs/videos/*.raw.webm

# Website (Next.js static site under website/)
website/node_modules/
website/.next/
website/out/
